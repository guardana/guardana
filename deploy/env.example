# Copy to `deploy/.env` and fill in. Nothing here has a default: Compose refuses
# to start rather than fall back to a credential somebody could guess.
#
# Generate a password without characters that need percent-encoding in a URL:
#
#   openssl rand -base64 33 | tr -d '/+=@:#' | cut -c1-32
#
# Keep the file out of version control (`deploy/.env` is git-ignored) and back it
# up somewhere your database backup is not: a backup that also contains the
# credentials for the thing it came from is one theft, not two.

POSTGRES_USER=guardana
POSTGRES_PASSWORD=
POSTGRES_DB=guardana

# The port the collector publishes on loopback. Your TLS terminator points here.
GUARDANA_PORT=8000
