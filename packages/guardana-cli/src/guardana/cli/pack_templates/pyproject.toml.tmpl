[project]
name = "__DIST__"
version = "0.1.0"
description = "Guardana rules and a target for __DIST__."
requires-python = ">=3.11"
classifiers = ["Typing :: Typed"]
# `guardana-core` is all a pack imports: the evaluators its rules name and the
# taxonomy catalogues their references resolve against live there. It is held from
# the release this pack was made with up to the next major, because everything the
# pack imports is in the supported surface, which changes incompatibly only in a
# major release. The commands that verify this pack ship in `guardana-cli`, which
# is the `guardana` you already run — a tool, not something this package imports.
dependencies = ["guardana-core>=__CORE_FLOOR__,<__CORE_CEILING__"]

[project.entry-points."guardana.rules"]
__MODULE__ = "__MODULE__:provide_rules"

[project.entry-points."guardana.evaluators"]
__MODULE__ = "__MODULE__:provide_evaluators"

[project.entry-points."guardana.targets"]
__MODULE__ = "__MODULE__:provide_targets"

[project.entry-points."guardana.taxonomies"]
__MODULE__ = "__MODULE__:provide_taxonomies"

[dependency-groups]
dev = ["pytest>=8"]

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = ["src/__MODULE__"]
